//===----------------------------------------------------------------------===//
//
// The HCS08 instruction set.
//
// The opcode map is highly regular: the low nibble of an opcode selects the
// operation and the high nibble selects the addressing mode, so most of this
// file is generated by multiclasses parameterized on the operation column.
// Operand names (b0, b1, w0) refer to the encoding fields declared by the
// format classes in HCS08InstrFormats.td; TableGen binds them by name.
//
//===----------------------------------------------------------------------===//

include "HCS08InstrFormats.td"

//===----------------------------------------------------------------------===//
// HCS08-specific DAG nodes (code generation).
//===----------------------------------------------------------------------===//

// Return with an optional glue operand, matched onto RTS.
def HCS08retglue : SDNode<"HCS08ISD::RET_GLUE", SDTNone,
                          [SDNPHasChain, SDNPOptInGlue, SDNPVariadic]>;

// The same, from an interrupt handler, matched onto RTI. Distinct from the
// above because the two returns undo different things: rts pops a return
// address a jsr pushed, rti pops the condition codes, A, X and the return
// address that the interrupt sequence pushed. Nothing calls a handler, so a
// function is one or the other and never both.
def HCS08retiglue : SDNode<"HCS08ISD::RETI_GLUE", SDTNone,
                           [SDNPHasChain, SDNPOptInGlue, SDNPVariadic]>;

// Wraps a constant address (e.g. a global) so it can be selected into an
// absolute-addressing operand.
def SDT_HCS08Wrapper : SDTypeProfile<1, 1, [SDTCisSameAs<0, 1>, SDTCisPtrTy<0>]>;
def HCS08Wrapper : SDNode<"HCS08ISD::Wrapper", SDT_HCS08Wrapper>;

// Compare, setting the condition codes (produces glue), and a conditional
// branch reading them.
def SDT_HCS08Cmp  : SDTypeProfile<0, 2, [SDTCisSameAs<0, 1>]>;
def SDT_HCS08BrCC : SDTypeProfile<0, 2, [SDTCisVT<0, OtherVT>, SDTCisVT<1, i8>]>;
def HCS08cmp  : SDNode<"HCS08ISD::CMP", SDT_HCS08Cmp, [SDNPOutGlue]>;
def HCS08brcc : SDNode<"HCS08ISD::BR_CC", SDT_HCS08BrCC,
                       [SDNPHasChain, SDNPInGlue]>;

// Pick between two values on the condition codes a preceding compare set.
def SDT_HCS08SelectCC : SDTypeProfile<1, 3, [SDTCisSameAs<0, 1>,
                                             SDTCisSameAs<1, 2>,
                                             SDTCisVT<3, i8>]>;
def HCS08selectcc : SDNode<"HCS08ISD::SELECT_CC", SDT_HCS08SelectCC,
                           [SDNPInGlue]>;

// Single-bit shifts of the accumulator. Multi-bit shifts by a constant are
// lowered to a chain of these.
def HCS08shl1 : SDNode<"HCS08ISD::SHL1", SDTIntUnaryOp>;
def HCS08srl1 : SDNode<"HCS08ISD::SRL1", SDTIntUnaryOp>;
def HCS08sra1 : SDNode<"HCS08ISD::SRA1", SDTIntUnaryOp>;

// Direct call and the call-sequence markers.
def SDT_HCS08Call : SDTypeProfile<0, -1, [SDTCisVT<0, iPTR>]>;
def HCS08call : SDNode<"HCS08ISD::CALL", SDT_HCS08Call,
                       [SDNPHasChain, SDNPOutGlue, SDNPOptInGlue, SDNPVariadic]>;
def SDT_HCS08CallSeqStart : SDCallSeqStart<[SDTCisVT<0, i16>, SDTCisVT<1, i16>]>;
def SDT_HCS08CallSeqEnd   : SDCallSeqEnd<[SDTCisVT<0, i16>, SDTCisVT<1, i16>]>;
def HCS08callseq_start : SDNode<"ISD::CALLSEQ_START", SDT_HCS08CallSeqStart,
                                [SDNPHasChain, SDNPOutGlue]>;
def HCS08callseq_end : SDNode<"ISD::CALLSEQ_END", SDT_HCS08CallSeqEnd,
                              [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue]>;

// Address of a byte in the outgoing-argument area of the reserved call frame.
// The operand is the SP-relative displacement, and it is already final: the
// call frame is allocated at the bottom of the frame, so displacement N is
// reachable as "N,sp" with no frame index to eliminate. See LowerCall.
def SDT_HCS08OutArg : SDTypeProfile<1, 1, [SDTCisVT<0, i16>, SDTCisVT<1, i8>]>;
def HCS08outarg : SDNode<"HCS08ISD::OutArgAddr", SDT_HCS08OutArg>;

// The address an indirect call returns to, as a value, so that it can be
// stored into the call frame for the rts to find. Its operand is the MCSymbol
// of the label the asm printer puts after that rts.
def SDT_HCS08RetAddr : SDTypeProfile<1, 1, [SDTCisVT<0, i16>, SDTCisVT<1, i16>]>;
def HCS08retaddr : SDNode<"HCS08ISD::RetAddr", SDT_HCS08RetAddr>;

// Pseudo-instruction base (no encoding).
class HCS08Pseudo<dag outs, dag ins, list<dag> pattern>
    : HCS08Inst<0, AddrModeNone, outs, ins, "", pattern> {
  let isPseudo = 1;
  let isCodeGenOnly = 1;
}

//===----------------------------------------------------------------------===//
// Operands
//===----------------------------------------------------------------------===//

def UImm16AsmOperand : AsmOperandClass {
  let Name = "UImm16";
  let RenderMethod = "addImmOperands";
  let DiagnosticString = "operand must be a 16-bit value or a symbol";
}

// UImm8 is a strict subset of UImm16. Declaring the superclass relationship
// lets the matcher prefer the direct-page form over the extended form when the
// operand is a constant that fits in a byte.
def UImm8AsmOperand : AsmOperandClass {
  let Name = "UImm8";
  let RenderMethod = "addImmOperands";
  let SuperClasses = [UImm16AsmOperand];
  let DiagnosticString = "operand must be an 8-bit value";
}

// 8-bit immediate, or an 8-bit index/stack displacement.
def imm8 : Operand<i8> {
  let ParserMatchClass = UImm8AsmOperand;
  let PrintMethod = "printImm8";
  let EncoderMethod = "getImm8OpValue";
}

// 16-bit immediate, extended address, or 16-bit index/stack displacement.
def imm16 : Operand<i16> {
  let ParserMatchClass = UImm16AsmOperand;
  let PrintMethod = "printImm16";
  let EncoderMethod = "getImm16OpValue";
}

// A direct-page address. It is an address, so it is i16-typed like every other
// one here - imm8 is an i8 and cannot hold one - but only the low byte is
// printed and encoded, which is the whole point of the mode. Printing it is
// not quite printing a byte: a symbol needs the '<' that forces this form,
// since the assembler cannot evaluate it and would otherwise choose the
// extended one. That is why displacements and immediates keep imm8, where a
// '<' would mean something else or nothing at all.
def dpmem : Operand<i16> {
  let ParserMatchClass = UImm8AsmOperand;
  let PrintMethod = "printDPMem";
  let EncoderMethod = "getImm8OpValue";
}

// PC-relative branch displacements. The displacement is measured from the end
// of the instruction, so the disassembler needs to know the instruction length
// to recover the absolute target; hence one operand per instruction size.
class BranchTarget<string dec> : Operand<i16> {
  let ParserMatchClass = UImm16AsmOperand;
  let PrintMethod = "printBranchTarget";
  let EncoderMethod = "getPCRel8OpValue";
  let DecoderMethod = dec;
  let OperandType = "OPERAND_PCREL";
}

def brtarget2 : BranchTarget<"decodeBranchTarget2">;
def brtarget3 : BranchTarget<"decodeBranchTarget3">;
def brtarget4 : BranchTarget<"decodeBranchTarget4">;

// The n,sp addressing mode as a single code-generation operand: a base, which
// carries a frame index until eliminateFrameIndex rewrites it to SP, plus a
// byte displacement. Only the displacement is printed and encoded - "sp" is
// part of the mnemonic form - so both jobs read past the base operand.
def spmem : Operand<i16> {
  let MIOperandInfo = (ops SPBASE, imm8);
  let PrintMethod = "printSPMem";
  let EncoderMethod = "getMemDispOpValue";
}

// A scratch slot for the pseudos that park an operand: the same (base,
// displacement) shape as spmem, but the base may be DPB instead of SP, meaning
// the displacement is a byte offset into the direct-page bank. Only pseudos
// use it, and they are gone before anything prints or encodes an operand,
// which is why it needs neither method.
def slotmem : Operand<i16> {
  let MIOperandInfo = (ops SLOTBASE, imm8);
}

// The n,x addressing modes, likewise: H:X as the base plus a displacement,
// one byte wide or two. The base really is a register here, so unlike spmem it
// survives register allocation as one.
def ixmem : Operand<i16> {
  let MIOperandInfo = (ops GR16, imm8);
  let PrintMethod = "printIXMem";
  let EncoderMethod = "getMemDispOpValue";
}

def ixmem16 : Operand<i16> {
  let MIOperandInfo = (ops GR16, imm16);
  let PrintMethod = "printIXMem16";
  let EncoderMethod = "getMemDisp16OpValue";
}

// The address shapes, kept disjoint so that exactly one matches: a frame
// object (n,sp), or a pointer with a byte displacement (n,x), a wider one
// (nn,x), or none (,x). A global or a fixed address goes through the absolute
// forms below instead, which reach it without tying up H:X.
//
// ixaddr stops one short of the byte range: a 16-bit access at displacement N
// also writes N+1, and keeping that in range everywhere is worth more than the
// one byte the ix2 form costs at displacement 255.
def stackaddr : ComplexPattern<i16, 2, "SelectStackAddr", [], []>;
def ixaddr : ComplexPattern<i16, 2, "SelectIndexedAddr", [], [], 10>;
def ixaddr16 : ComplexPattern<i16, 2, "SelectIndexedAddr16", [], [], 5>;
def ixbase : ComplexPattern<i16, 1, "SelectIndexedBase", [], []>;

// The two absolute shapes. Every operand they take is one byte shorter in the
// direct-page form, so dpaddr outranks extaddr and both outrank the indexed
// forms, which need the address in H:X first. dpaddr matches only what is
// known at compile time to be below $0100: a fixed address, or a global the
// user has placed in the direct page (see SelectDirectAddr).
def dpaddr : ComplexPattern<i16, 1, "SelectDirectAddr", [], [], 20>;
def extaddr : ComplexPattern<i16, 1, "SelectExtendedAddr", [], [], 15>;

//===----------------------------------------------------------------------===//
// Load / store / arithmetic: the regular 8-addressing-mode matrix.
//
// Column (low nibble) selects the operation; row (high nibble) selects the
// mode: A=immediate, B=direct, C=extended, D=indexed 16-bit, E=indexed 8-bit,
// F=indexed no offset. Page 2 (0x9E prefix) reuses rows D and E for the
// stack-relative modes.
//===----------------------------------------------------------------------===//

// Modes shared by every operation in the matrix.
multiclass ALUCommon<bits<4> col, string m> {
  def _dir : F16<{0b1011, col}, AddrModeDir, (outs), (ins dpmem:$b0),
                 m # "\t$b0">;
  def _ext : F24<{0b1100, col}, AddrModeExt, (outs), (ins imm16:$w0),
                 m # "\t$w0">;
  def _ix2 : F24<{0b1101, col}, AddrModeIx2, (outs), (ins imm16:$w0),
                 m # "\t$w0,x">;
  def _ix1 : F16<{0b1110, col}, AddrModeIx1, (outs), (ins imm8:$b0),
                 m # "\t$b0,x">;
  def _ix  : F8 <{0b1111, col}, AddrModeIx, (outs), (ins), m # "\t,x">;
}

// Stack-relative forms, available for every column except JMP and JSR.
multiclass ALUStack<bits<4> col, string m> {
  def _sp2 : F32P<{0b1101, col}, AddrModeSp2, (outs), (ins imm16:$w0),
                  m # "\t$w0,sp">;
  def _sp1 : F24P<{0b1110, col}, AddrModeSp1, (outs), (ins imm8:$b0),
                  m # "\t$b0,sp">;
}

// Operations with an immediate form: sub, cmp, sbc, cpx, and, bit, lda, eor,
// adc, ora, add, ldx.
multiclass ALUOp<bits<4> col, string m> : ALUCommon<col, m>, ALUStack<col, m> {
  def _imm : F16<{0b1010, col}, AddrModeImm, (outs), (ins imm8:$b0),
                 m # "\t#$b0">;
}

// Stores have no immediate form.
multiclass StoreOp<bits<4> col, string m> : ALUCommon<col, m>,
                                            ALUStack<col, m>;

defm SUB : ALUOp<0x0, "sub">;
defm CMP : ALUOp<0x1, "cmp">;
defm SBC : ALUOp<0x2, "sbc">;
defm CPX : ALUOp<0x3, "cpx">;
defm AND : ALUOp<0x4, "and">;
defm BIT : ALUOp<0x5, "bit">;
defm LDA : ALUOp<0x6, "lda">;
defm STA : StoreOp<0x7, "sta">;
defm EOR : ALUOp<0x8, "eor">;
defm ADC : ALUOp<0x9, "adc">;
defm ORA : ALUOp<0xA, "ora">;
defm ADD : ALUOp<0xB, "add">;
defm LDX : ALUOp<0xE, "ldx">;
defm STX : StoreOp<0xF, "stx">;

let isBranch = 1, isTerminator = 1, isBarrier = 1 in
defm JMP : ALUCommon<0xC, "jmp">;

let isCall = 1 in
defm JSR : ALUCommon<0xD, "jsr">;

// The immediate row reuses the store columns for the two "add immediate to
// pointer register" instructions, which take a signed byte.
def AIS : F16<0xA7, AddrModeImm, (outs), (ins imm8:$b0), "ais\t#$b0">;
def AIX : F16<0xAF, AddrModeImm, (outs), (ins imm8:$b0), "aix\t#$b0">;

//===----------------------------------------------------------------------===//
// Read-modify-write group.
//
// Row 3=direct, 4=accumulator, 5=X, 6=indexed 8-bit, 7=indexed no offset, and
// page-2 row 6=stack-relative.
//===----------------------------------------------------------------------===//

multiclass RMW<bits<4> col, string m> {
  def _dir : F16<{0b0011, col}, AddrModeDir, (outs), (ins dpmem:$b0),
                 m # "\t$b0">;
  def A    : F8 <{0b0100, col}, AddrModeInh, (outs), (ins), m # "a">;
  def X    : F8 <{0b0101, col}, AddrModeInh, (outs), (ins), m # "x">;
  def _ix1 : F16<{0b0110, col}, AddrModeIx1, (outs), (ins imm8:$b0),
                 m # "\t$b0,x">;
  def _ix  : F8 <{0b0111, col}, AddrModeIx, (outs), (ins), m # "\t,x">;
  def _sp1 : F24P<{0b0110, col}, AddrModeSp1, (outs), (ins imm8:$b0),
                  m # "\t$b0,sp">;
}

defm NEG : RMW<0x0, "neg">;
defm COM : RMW<0x3, "com">;
defm LSR : RMW<0x4, "lsr">;
defm ROR : RMW<0x6, "ror">;
defm ASR : RMW<0x7, "asr">;
defm LSL : RMW<0x8, "lsl">;
defm ROL : RMW<0x9, "rol">;
defm DEC : RMW<0xA, "dec">;
defm INC : RMW<0xC, "inc">;
defm TST : RMW<0xD, "tst">;
defm CLR : RMW<0xF, "clr">;

// "asl" is the traditional alias for "lsl"; they are the same opcodes.
def : MnemonicAlias<"asl", "lsl">;
def : MnemonicAlias<"asla", "lsla">;
def : MnemonicAlias<"aslx", "lslx">;

//===----------------------------------------------------------------------===//
// Compare-and-branch and decrement-and-branch.
//
// These occupy columns 1 and B of the read-modify-write rows but take an extra
// branch displacement, so they do not fit the RMW multiclass.
//===----------------------------------------------------------------------===//

let isBranch = 1, isTerminator = 1 in {
def CBEQ_dir  : F24B<0x31, AddrModeDirRel, (outs),
                     (ins dpmem:$b0, brtarget3:$b1), "cbeq\t$b0,$b1">;
def CBEQA_imm : F24B<0x41, AddrModeDirRel, (outs), (ins imm8:$b0, brtarget3:$b1),
                     "cbeqa\t#$b0,$b1">;
def CBEQX_imm : F24B<0x51, AddrModeDirRel, (outs), (ins imm8:$b0, brtarget3:$b1),
                     "cbeqx\t#$b0,$b1">;
def CBEQ_ix1p : F24B<0x61, AddrModeDirRel, (outs), (ins imm8:$b0, brtarget3:$b1),
                     "cbeq\t$b0,x+,$b1">;
def CBEQ_ixp  : F16 <0x71, AddrModeRel, (outs), (ins brtarget2:$b0),
                     "cbeq\t,x+,$b0">;
def CBEQ_sp1  : F32PB<0x61, AddrModeSp1, (outs), (ins imm8:$b0, brtarget4:$b1),
                      "cbeq\t$b0,sp,$b1">;

def DBNZ_dir  : F24B<0x3B, AddrModeDirRel, (outs),
                     (ins dpmem:$b0, brtarget3:$b1), "dbnz\t$b0,$b1">;
def DBNZA     : F16 <0x4B, AddrModeRel, (outs), (ins brtarget2:$b0),
                     "dbnza\t$b0">;
def DBNZX     : F16 <0x5B, AddrModeRel, (outs), (ins brtarget2:$b0),
                     "dbnzx\t$b0">;
def DBNZ_ix1  : F24B<0x6B, AddrModeDirRel, (outs), (ins imm8:$b0, brtarget3:$b1),
                     "dbnz\t$b0,x,$b1">;
def DBNZ_ix   : F16 <0x7B, AddrModeRel, (outs), (ins brtarget2:$b0),
                     "dbnz\t,x,$b0">;
def DBNZ_sp1  : F32PB<0x6B, AddrModeSp1, (outs), (ins imm8:$b0, brtarget4:$b1),
                      "dbnz\t$b0,sp,$b1">;
}

//===----------------------------------------------------------------------===//
// Bit manipulation on the direct page.
//===----------------------------------------------------------------------===//

// bset n,$dd / bclr n,$dd occupy 0x10-0x1F, with the bit number in opcode bits
// 3-1 and set/clear in bit 0.
foreach i = 0-7 in {
  def BSET#i : F16<!add(0x10, !mul(i, 2)), AddrModeDir, (outs), (ins dpmem:$b0),
                   "bset\t" # i # ",$b0">;
  def BCLR#i : F16<!add(0x11, !mul(i, 2)), AddrModeDir, (outs), (ins dpmem:$b0),
                   "bclr\t" # i # ",$b0">;
}

// brset n,$dd,rr / brclr n,$dd,rr occupy 0x00-0x0F with the same layout.
let isBranch = 1, isTerminator = 1 in
foreach i = 0-7 in {
  def BRSET#i : F24B<!add(0x00, !mul(i, 2)), AddrModeDirRel, (outs),
                     (ins dpmem:$b0, brtarget3:$b1),
                     "brset\t" # i # ",$b0,$b1">;
  def BRCLR#i : F24B<!add(0x01, !mul(i, 2)), AddrModeDirRel, (outs),
                     (ins dpmem:$b0, brtarget3:$b1),
                     "brclr\t" # i # ",$b0,$b1">;
}

//===----------------------------------------------------------------------===//
// Branches
//===----------------------------------------------------------------------===//

class Branch<bits<8> op, string m>
    : F16<op, AddrModeRel, (outs), (ins brtarget2:$b0), m # "\t$b0"> {
  let isBranch = 1;
  let isTerminator = 1;
}

let isBarrier = 1 in
def BRA : Branch<0x20, "bra">;

def BRN  : Branch<0x21, "brn">;
def BHI  : Branch<0x22, "bhi">;
def BLS  : Branch<0x23, "bls">;
def BCC  : Branch<0x24, "bcc">;
def BCS  : Branch<0x25, "bcs">;
def BNE  : Branch<0x26, "bne">;
def BEQ  : Branch<0x27, "beq">;
def BHCC : Branch<0x28, "bhcc">;
def BHCS : Branch<0x29, "bhcs">;
def BPL  : Branch<0x2A, "bpl">;
def BMI  : Branch<0x2B, "bmi">;
def BMC  : Branch<0x2C, "bmc">;
def BMS  : Branch<0x2D, "bms">;
def BIL  : Branch<0x2E, "bil">;
def BIH  : Branch<0x2F, "bih">;
def BGE  : Branch<0x90, "bge">;
def BLT  : Branch<0x91, "blt">;
def BGT  : Branch<0x92, "bgt">;
def BLE  : Branch<0x93, "ble">;

// Unsigned aliases carried by every HC08 assembler.
def : MnemonicAlias<"blo", "bcs">;
def : MnemonicAlias<"bhs", "bcc">;

let isCall = 1 in
def BSR : F16<0xAD, AddrModeRel, (outs), (ins brtarget2:$b0), "bsr\t$b0">;

//===----------------------------------------------------------------------===//
// 16-bit index register instructions (ldhx / sthx / cphx).
//
// The direct, extended and immediate forms are HCS08 additions to the original
// HC08 map, and the indexed and stack-relative forms live on page 2.
//===----------------------------------------------------------------------===//

def LDHX_imm : F24 <0x45, AddrModeImm, (outs), (ins imm16:$w0), "ldhx\t#$w0">;
def LDHX_dir : F16 <0x55, AddrModeDir, (outs), (ins dpmem:$b0), "ldhx\t$b0">;
def LDHX_ext : F24 <0x32, AddrModeExt, (outs), (ins imm16:$w0), "ldhx\t$w0">;
def LDHX_ix  : F16P<0xAE, AddrModeIx, (outs), (ins), "ldhx\t,x">;
def LDHX_ix2 : F32P<0xBE, AddrModeIx2, (outs), (ins imm16:$w0), "ldhx\t$w0,x">;
def LDHX_ix1 : F24P<0xCE, AddrModeIx1, (outs), (ins imm8:$b0), "ldhx\t$b0,x">;
def LDHX_sp1 : F24P<0xFE, AddrModeSp1, (outs), (ins imm8:$b0), "ldhx\t$b0,sp">;

def STHX_dir : F16 <0x35, AddrModeDir, (outs), (ins dpmem:$b0), "sthx\t$b0">;
def STHX_ext : F24 <0x96, AddrModeExt, (outs), (ins imm16:$w0), "sthx\t$w0">;
def STHX_sp1 : F24P<0xFF, AddrModeSp1, (outs), (ins imm8:$b0), "sthx\t$b0,sp">;

def CPHX_imm : F24 <0x65, AddrModeImm, (outs), (ins imm16:$w0), "cphx\t#$w0">;
def CPHX_dir : F16 <0x75, AddrModeDir, (outs), (ins dpmem:$b0), "cphx\t$b0">;
def CPHX_ext : F24 <0x3E, AddrModeExt, (outs), (ins imm16:$w0), "cphx\t$w0">;
def CPHX_sp1 : F24P<0xF3, AddrModeSp1, (outs), (ins imm8:$b0), "cphx\t$b0,sp">;

//===----------------------------------------------------------------------===//
// Memory-to-memory move (HCS08).
//===----------------------------------------------------------------------===//

def MOV_dd   : F24B<0x4E, AddrModeDd, (outs), (ins dpmem:$b0, dpmem:$b1),
                    "mov\t$b0,$b1">;
def MOV_dix  : F16 <0x5E, AddrModeDir, (outs), (ins dpmem:$b0), "mov\t$b0,x+">;
def MOV_imd  : F24B<0x6E, AddrModeImd, (outs), (ins imm8:$b0, dpmem:$b1),
                    "mov\t#$b0,$b1">;
def MOV_ixd  : F16 <0x7E, AddrModeDir, (outs), (ins dpmem:$b0), "mov\t,x+,$b0">;

//===----------------------------------------------------------------------===//
// Inherent instructions
//===----------------------------------------------------------------------===//

class Inherent<bits<8> op, string m> : F8<op, AddrModeInh, (outs), (ins), m>;

def MUL : Inherent<0x42, "mul">;
def DIV : Inherent<0x52, "div">;
def NSA : Inherent<0x62, "nsa">;
def DAA : Inherent<0x72, "daa">;

let isReturn = 1, isTerminator = 1, isBarrier = 1 in {
def RTI : Inherent<0x80, "rti">;
def RTS : Inherent<0x81, "rts">;
}

def BGND : Inherent<0x82, "bgnd">;
def SWI  : Inherent<0x83, "swi">;
def TAP  : Inherent<0x84, "tap">;
def TPA  : Inherent<0x85, "tpa">;
def PULA : Inherent<0x86, "pula">;
def PSHA : Inherent<0x87, "psha">;
def PULX : Inherent<0x88, "pulx">;
def PSHX : Inherent<0x89, "pshx">;
def PULH : Inherent<0x8A, "pulh">;
def PSHH : Inherent<0x8B, "pshh">;
def CLRH : Inherent<0x8C, "clrh">;
def STOP : Inherent<0x8E, "stop">;
def WAIT : Inherent<0x8F, "wait">;
def TXS  : Inherent<0x94, "txs">;
def TSX  : Inherent<0x95, "tsx">;
def TAX  : Inherent<0x97, "tax">;
def CLC  : Inherent<0x98, "clc">;
def SEC  : Inherent<0x99, "sec">;
def CLI  : Inherent<0x9A, "cli">;
def SEI  : Inherent<0x9B, "sei">;
def RSP  : Inherent<0x9C, "rsp">;

let hasSideEffects = 0 in
def NOP  : Inherent<0x9D, "nop">;

def TXA  : Inherent<0x9F, "txa">;

//===----------------------------------------------------------------------===//
// Code generation patterns
//===----------------------------------------------------------------------===//

// A function return lowers to RTS, and an interrupt handler's to RTI.
def : Pat<(HCS08retglue), (RTS)>;
def : Pat<(HCS08retiglue), (RTI)>;

// Code-generation-only views of the immediate loads. The MC-layer forms are
// accumulator-implicit (no register operands); these carry the def register so
// the selector can model the data flow. They share the real encodings and are
// excluded from the assembler/disassembler by isCodeGenOnly.
let isCodeGenOnly = 1, hasSideEffects = 0, Defs = [NZV] in {
  def LDAi : F16<0xA6, AddrModeImm, (outs GR8:$dst), (ins imm8:$b0),
                 "lda\t#$b0", [(set GR8:$dst, imm:$b0)]>;
  def LDHXi : F24<0x45, AddrModeImm, (outs GR16:$dst), (ins imm16:$w0),
                  "ldhx\t#$w0", [(set GR16:$dst, imm:$w0)]>;
}

// Absolute loads and stores: globals, and addresses fixed at compile time.
// The extended forms take a 16-bit operand and reach anywhere; the direct
// forms take one byte and reach the direct page. For a symbol the operand
// becomes an R_HCS08_16 or an R_HCS08_8 relocation, and it is the second of
// those that makes the linker check that the variable really did land in the
// page the code was compiled to assume.
let isCodeGenOnly = 1, Defs = [NZV] in {
  def LDAdir : F16<0xB6, AddrModeDir, (outs GR8:$dst), (ins dpmem:$b0),
                   "lda\t$b0", [(set GR8:$dst, (load dpaddr:$b0))]>;
  def LDAext : F24<0xC6, AddrModeExt, (outs GR8:$dst), (ins imm16:$w0),
                   "lda\t$w0", [(set GR8:$dst, (load extaddr:$w0))]>;
  def LDHXdir : F16<0x55, AddrModeDir, (outs GR16:$dst), (ins dpmem:$b0),
                    "ldhx\t$b0", [(set GR16:$dst, (load dpaddr:$b0))]>;
  def LDHXext : F24<0x32, AddrModeExt, (outs GR16:$dst), (ins imm16:$w0),
                    "ldhx\t$w0", [(set GR16:$dst, (load extaddr:$w0))]>;

  let mayStore = 1 in {
    def STAdir : F16<0xB7, AddrModeDir, (outs), (ins GR8:$src, dpmem:$b0),
                     "sta\t$b0", [(store GR8:$src, dpaddr:$b0)]>;
    def STAext : F24<0xC7, AddrModeExt, (outs), (ins GR8:$src, imm16:$w0),
                     "sta\t$w0", [(store GR8:$src, extaddr:$w0)]>;
    def STHXdir : F16<0x35, AddrModeDir, (outs), (ins GR16:$src, dpmem:$b0),
                      "sthx\t$b0", [(store GR16:$src, dpaddr:$b0)]>;
    def STHXext : F24<0x96, AddrModeExt, (outs), (ins GR16:$src, imm16:$w0),
                      "sthx\t$w0", [(store GR16:$src, extaddr:$w0)]>;
  }
}

// A bare global address (e.g. taking its value into H:X).
def : Pat<(i16 (HCS08Wrapper tglobaladdr:$addr)), (LDHXi tglobaladdr:$addr)>;

//===----------------------------------------------------------------------===//
// Indexed load/store: dereferencing a pointer held in H:X.
//
// H:X is the only index register, so it holds the pointer and, for a 16-bit
// load, receives the result as well - which is fine, since the pointer is dead
// by then. A 16-bit *store* has no indexed form on this machine (sthx is
// direct/extended/stack only), so it goes through STHXix below.
//
// Displacements beyond a byte would need the ix2 forms; the address is
// materialized with aix instead for now.
//===----------------------------------------------------------------------===//

let isCodeGenOnly = 1, hasSideEffects = 0, Defs = [NZV] in {
  let mayLoad = 1 in {
    def LDAix : F8<0xF6, AddrModeIx, (outs GR8:$dst), (ins GR16:$base),
                   "lda\t,x", [(set GR8:$dst, (load ixbase:$base))]>;
    def LDAix1 : F16<0xE6, AddrModeIx1, (outs GR8:$dst), (ins ixmem:$b0),
                     "lda\t$b0", [(set GR8:$dst, (load ixaddr:$b0))]>;
    def LDAix2 : F24<0xD6, AddrModeIx2, (outs GR8:$dst), (ins ixmem16:$w0),
                     "lda\t$w0", [(set GR8:$dst, (load ixaddr16:$w0))]>;
    def LDHXix : F16P<0xAE, AddrModeIx, (outs GR16:$dst), (ins GR16:$base),
                      "ldhx\t,x", [(set GR16:$dst, (load ixbase:$base))]>;
    def LDHXix1 : F24P<0xCE, AddrModeIx1, (outs GR16:$dst), (ins ixmem:$b0),
                       "ldhx\t$b0", [(set GR16:$dst, (load ixaddr:$b0))]>;
    def LDHXix2 : F32P<0xBE, AddrModeIx2, (outs GR16:$dst), (ins ixmem16:$w0),
                       "ldhx\t$w0", [(set GR16:$dst, (load ixaddr16:$w0))]>;
  }
  let mayStore = 1 in {
    def STAix : F8<0xF7, AddrModeIx, (outs), (ins GR8:$src, GR16:$base),
                   "sta\t,x", [(store GR8:$src, ixbase:$base)]>;
    def STAix1 : F16<0xE7, AddrModeIx1, (outs), (ins GR8:$src, ixmem:$b0),
                     "sta\t$b0", [(store GR8:$src, ixaddr:$b0)]>;
    def STAix2 : F24<0xD7, AddrModeIx2, (outs), (ins GR8:$src, ixmem16:$w0),
                     "sta\t$w0", [(store GR8:$src, ixaddr16:$w0)]>;

    // A 16-bit store through a pointer, byte by byte. Both the value and the
    // pointer want H:X, so the value is parked in a frame slot and its two
    // bytes are carried through A; see EmitInstrWithCustomInserter. The
    // displacement is a byte, which is why ixaddr stops at 254.
    let isPseudo = 1, usesCustomInserter = 1, Defs = [NZV] in
    def STHXix : HCS08Inst<0, AddrModeNone, (outs), (ins GR16:$src, ixmem:$b0),
                           "", [(store GR16:$src, ixaddr:$b0)]>;
  }
}

// A 16-bit store through a bare pointer is the same thing at displacement 0.
def : Pat<(store GR16:$src, ixbase:$base), (STHXix GR16:$src, GR16:$base, 0)>;

// 16-bit add of a signed-byte constant to H:X (pointer arithmetic): aix #n.
// AIX does not affect the condition codes. sub-by-constant is canonicalized to
// add of the negated constant, so it maps here too. General i16 + i16 is not
// yet supported (it needs a byte-wise carry chain through A).
def i16SExt8 : PatLeaf<(i16 imm), [{
  int64_t V = N->getSExtValue();
  return V >= -128 && V <= 127;
}]>;
def LO8xform : SDNodeXForm<imm, [{
  return CurDAG->getTargetConstant(N->getZExtValue() & 0xFF, SDLoc(N), MVT::i8);
}]>;

let isCodeGenOnly = 1, Constraints = "$src = $dst", hasSideEffects = 0 in
def AIXi : F16<0xAF, AddrModeImm, (outs GR16:$dst), (ins GR16:$src, imm8:$b0),
               "aix\t#$b0", []>;

def : Pat<(add GR16:$src, i16SExt8:$c), (AIXi GR16:$src, (LO8xform $c))>;

//===----------------------------------------------------------------------===//
// 8-bit accumulator ALU (code generation).
//
// These operate in place on A ($src tied to $dst) with an immediate or a
// memory (extended) operand, and set the condition codes.
//===----------------------------------------------------------------------===//

// Parameterized on the opcode column, like the MC-layer multiclasses above:
// the addressing mode is the high nibble, so every form falls out of it.
multiclass ALU8<bits<4> col, string m, SDNode op, list<Register> flags> {
  let Constraints = "$src = $dst", isCodeGenOnly = 1, hasSideEffects = 0,
      Defs = flags in {
    def i : F16<{0b1010, col}, AddrModeImm, (outs GR8:$dst),
                (ins GR8:$src, imm8:$b0), m # "\t#$b0",
                [(set GR8:$dst, (op GR8:$src, imm:$b0))]>;
    def dir : F16<{0b1011, col}, AddrModeDir, (outs GR8:$dst),
                  (ins GR8:$src, dpmem:$b0), m # "\t$b0",
                  [(set GR8:$dst, (op GR8:$src, (load dpaddr:$b0)))]>;
    def ext : F24<{0b1100, col}, AddrModeExt, (outs GR8:$dst),
                  (ins GR8:$src, imm16:$w0), m # "\t$w0",
                  [(set GR8:$dst, (op GR8:$src, (load extaddr:$w0)))]>;
    // Indexed forms: the second operand is read through a pointer in H:X.
    let mayLoad = 1 in {
      def ix2 : F24<{0b1101, col}, AddrModeIx2, (outs GR8:$dst),
                    (ins GR8:$src, ixmem16:$w0), m # "\t$w0",
                    [(set GR8:$dst, (op GR8:$src, (load ixaddr16:$w0)))]>;
      def ix1 : F16<{0b1110, col}, AddrModeIx1, (outs GR8:$dst),
                    (ins GR8:$src, ixmem:$b0), m # "\t$b0",
                    [(set GR8:$dst, (op GR8:$src, (load ixaddr:$b0)))]>;
      def ix : F8<{0b1111, col}, AddrModeIx, (outs GR8:$dst),
                  (ins GR8:$src, GR16:$base), m # "\t,x",
                  [(set GR8:$dst, (op GR8:$src, (load ixbase:$base)))]>;
    }
    // Stack-relative form: the second operand comes from a frame object,
    // which covers incoming stack arguments and allocas directly.
    let mayLoad = 1 in
    def sp : F24P<{0b1110, col}, AddrModeSp1, (outs GR8:$dst),
                  (ins GR8:$src, spmem:$b0), m # "\t$b0",
                  [(set GR8:$dst, (op GR8:$src, (load stackaddr:$b0)))]>;
    // Reg-reg fallback, for a second operand that is genuinely in a register
    // (a call result, say). HCS08 has no reg-reg ALU and A is the only 8-bit
    // register, so this cannot be emitted: EmitInstrWithCustomInserter gives
    // the second source a stack slot and rewrites it to the sp form above,
    // before register allocation has to find two registers for it.
    let isPseudo = 1, usesCustomInserter = 1 in
    def rr : HCS08Inst<0, AddrModeNone, (outs GR8:$dst),
                       (ins GR8:$src, GR8:$src2), "",
                       [(set GR8:$dst, (op GR8:$src, GR8:$src2))]>;
  }
}

defm ADD8 : ALU8<0xB, "add", add, [NZV, C]>;
defm SUB8 : ALU8<0x0, "sub", sub, [NZV, C]>;
defm AND8 : ALU8<0x4, "and", and, [NZV]>;
defm ORA8 : ALU8<0xA, "ora", or,  [NZV]>;
defm EOR8 : ALU8<0x8, "eor", xor, [NZV]>;

// The carry-in halves of the 16-bit chains. Nothing selects these directly -
// they are built by hand in expandPostRAPseudo - so they carry no pattern, but
// they do read C, which is what keeps anything that writes it from being
// scheduled between them and the add or sub that set it. The loads and stores
// the chain interleaves with write NZV and not C, so they are free to sit
// there - which is the whole reason the two are separate registers.
let isCodeGenOnly = 1, Constraints = "$src = $dst", hasSideEffects = 0,
    mayLoad = 1, Defs = [NZV, C], Uses = [C] in {
  def ADC8sp : F24P<0xE9, AddrModeSp1, (outs GR8:$dst),
                    (ins GR8:$src, spmem:$b0), "adc\t$b0", []>;
  def SBC8sp : F24P<0xE2, AddrModeSp1, (outs GR8:$dst),
                    (ins GR8:$src, spmem:$b0), "sbc\t$b0", []>;
  // The same for an operand parked in the direct-page bank. The rest of the
  // 8-bit column gets its direct form from the ALU8 multiclass; these two are
  // written out because they carry the Uses = [C] that the chain depends on.
  def ADC8dir : F16<0xB9, AddrModeDir, (outs GR8:$dst),
                    (ins GR8:$src, dpmem:$b0), "adc\t$b0", []>;
  def SBC8dir : F16<0xB2, AddrModeDir, (outs GR8:$dst),
                    (ins GR8:$src, dpmem:$b0), "sbc\t$b0", []>;
}

//===----------------------------------------------------------------------===//
// General 16-bit ALU.
//
// There is no 16-bit ALU here beyond aix, so these become byte chains through
// A, low byte first so that add and sub can carry into the high byte. Two
// problems have to be solved separately:
//
//  - H:X cannot hold two 16-bit values, so both operands must be in memory.
//    EmitInstrWithCustomInserter parks them in frame slots before register
//    allocation, which is where that has to happen.
//
//  - the carry must survive from the low byte's add to the high byte's adc.
//    The chain is therefore emitted in expandPostRAPseudo, after everything
//    that could insert an instruction into the middle of it has run. (lda and
//    sta do not disturb the carry, but relying on which instructions land
//    there would be relying on luck.)
//===----------------------------------------------------------------------===//

class ALU16rr<SDNode op>
    : HCS08Inst<0, AddrModeNone, (outs GR16:$dst), (ins GR16:$src, GR16:$src2),
                "", [(set GR16:$dst, (op GR16:$src, GR16:$src2))]> {
  let isPseudo = 1;
  let isCodeGenOnly = 1;
  let usesCustomInserter = 1;
  let Defs = [A, NZV, C];
  let hasSideEffects = 0;
}

def ADD16rr : ALU16rr<add>;
def SUB16rr : ALU16rr<sub>;
def AND16rr : ALU16rr<and>;
def ORA16rr : ALU16rr<or>;
def EOR16rr : ALU16rr<xor>;

// The same where the second operand is already a frame object - an incoming
// stack argument or an alloca - which is worth its own form: it is the common
// shape for a two-argument function, and parking a value that is already in
// memory costs a round trip through H:X that the allocator then has to spill
// around.
class ALU16rm<SDNode op>
    : HCS08Inst<0, AddrModeNone, (outs GR16:$dst), (ins GR16:$src, spmem:$b),
                "", [(set GR16:$dst, (op GR16:$src, (load stackaddr:$b)))]> {
  let isPseudo = 1;
  let isCodeGenOnly = 1;
  let usesCustomInserter = 1;
  let Defs = [A, NZV, C];
  let mayLoad = 1;
  let hasSideEffects = 0;
}

def ADD16rm : ALU16rm<add>;
def SUB16rm : ALU16rm<sub>;
def AND16rm : ALU16rm<and>;
def ORA16rm : ALU16rm<or>;
def EOR16rm : ALU16rm<xor>;

// The parked form: both operands are parked by now, in the frame or in the
// direct-page bank. The result is built in the first of them and loaded into
// H:X - seven instructions, three bytes each from the frame and two from the
// bank, which is what makes the first operand worth putting there.
class ALU16mem
    : HCS08Inst<21, AddrModeNone, (outs GR16:$dst),
                (ins slotmem:$a, slotmem:$b), "", []> {
  let isPseudo = 1;
  let isCodeGenOnly = 1;
  let Defs = [A, NZV, C];
  let mayLoad = 1;
  let mayStore = 1;
  let hasSideEffects = 0;
}

def ADD16m : ALU16mem;
def SUB16m : ALU16mem;
def AND16m : ALU16mem;
def ORA16m : ALU16mem;
def EOR16m : ALU16mem;

//===----------------------------------------------------------------------===//
// Changing width between the accumulator and the index register.
//
// The two registers are the two widths, so these are transfers: X is the low
// half of H:X, which makes truncation a single txa, and widening a matter of
// getting the right thing into H.
//===----------------------------------------------------------------------===//

// The low byte of H:X is X.
let isCodeGenOnly = 1, hasSideEffects = 0 in
def TXAd : F8<0x9F, AddrModeInh, (outs GR8:$dst), (ins GR16:$src), "txa",
              [(set GR8:$dst, (trunc GR16:$src))]>;

let isPseudo = 1, isCodeGenOnly = 1, hasSideEffects = 0 in {
  // tax then clrh. Neither writes A or any flag, so this clobbers nothing. An
  // any-extend goes the same way rather than leaving H undefined, which would
  // be a value nothing later is allowed to look at.
  def ZEXT8to16 : HCS08Inst<2, AddrModeNone, (outs GR16:$dst), (ins GR8:$src),
                            "", []>;
  // tax, then a copy of the sign bit into H, built without branching:
  // lsla puts it in the carry, and 0 - 0 - carry is 0 or -1. That walks
  // through A and both flag groups.
  let Defs = [A, NZV, C] in
  def SEXT8to16 : HCS08Inst<7, AddrModeNone, (outs GR16:$dst), (ins GR8:$src),
                            "", []>;
  // The same sign splat one size up: a word in, and 0 or -1 out according to
  // its sign. The sign lives in the high byte, so this reaches H through the
  // stack first and then runs the SEXT8to16 tail.
  let Defs = [A, NZV, C], Constraints = "$src = $dst" in
  def SIGNMASK16 : HCS08Inst<9, AddrModeNone, (outs GR16:$dst), (ins GR16:$src),
                             "", []>;
}

def : Pat<(i16 (zext GR8:$src)), (ZEXT8to16 GR8:$src)>;
def : Pat<(i16 (anyext GR8:$src)), (ZEXT8to16 GR8:$src)>;
def : Pat<(i16 (sext GR8:$src)), (SEXT8to16 GR8:$src)>;

// Widening a word to a doubleword is expanded by type legalization into the
// word itself and an arithmetic shift right by 15, so that shift is what a
// sign extension actually looks like by the time it gets here. Left to the
// generic path it becomes the variable-count loop below - fifteen iterations
// to compute one of two answers, and, far worse, a loop in the middle of
// whatever it was part of. When the argument of a call is what is being
// widened, the branches land between ADJCALLSTACKDOWN and the call itself and
// tear the call frame across basic blocks, which the machine verifier
// rejects. Matching the shift here keeps it straight-line.
def : Pat<(sra GR16:$src, (i8 15)), (SIGNMASK16 GR16:$src)>;

//===----------------------------------------------------------------------===//
// Multiply and divide.
//
// Both are single instructions, but both work on X as well as A, so the second
// operand has to reach X - which ldx can do straight from memory, and memory is
// where the custom inserter parks it anyway.
//
//   mul  X:A <- A * X          low half in A, high half in X
//   div  A <- H:A / X, H <- remainder
//
// A byte divide therefore needs H cleared first, and the remainder comes back
// in H, which only the stack can reach.
//===----------------------------------------------------------------------===//

let isCodeGenOnly = 1, hasSideEffects = 0 in {
  let mayLoad = 1, Defs = [X, NZV] in
  def LDXsp : F24P<0xEE, AddrModeSp1, (outs), (ins spmem:$b0), "ldx\t$b0", []>;

  let Defs = [H] in
  def CLRHd : F8<0x8C, AddrModeInh, (outs), (ins), "clrh", []>;

  let Constraints = "$src = $dst", Uses = [X] in {
    // mul leaves the high half in X and clears the carry; it does not touch
    // N, Z or V.
    let Defs = [X, C] in
    def MUL8 : F8<0x42, AddrModeInh, (outs GR8:$dst), (ins GR8:$src), "mul",
                  []>;
    let Defs = [H, NZV, C], Uses = [X, H] in
    def DIV8 : F8<0x52, AddrModeInh, (outs GR8:$dst), (ins GR8:$src), "div",
                  []>;
  }

  // The second operand is in a register, which neither instruction can use:
  // parked by the custom inserter and loaded into X from there.
  let isPseudo = 1, usesCustomInserter = 1, Defs = [X, H, NZV, C] in {
    def MUL8rr : HCS08Inst<0, AddrModeNone, (outs GR8:$dst),
                           (ins GR8:$src, GR8:$src2), "",
                           [(set GR8:$dst, (mul GR8:$src, GR8:$src2))]>;
    def UDIV8rr : HCS08Inst<0, AddrModeNone, (outs GR8:$dst),
                            (ins GR8:$src, GR8:$src2), "",
                            [(set GR8:$dst, (udiv GR8:$src, GR8:$src2))]>;
    def UREM8rr : HCS08Inst<0, AddrModeNone, (outs GR8:$dst),
                            (ins GR8:$src, GR8:$src2), "",
                            [(set GR8:$dst, (urem GR8:$src, GR8:$src2))]>;
  }
}

//===----------------------------------------------------------------------===//
// The stack-relative read-modify-write forms.
//
// A shift by a variable amount is a loop whichever way it is written, and it
// is written in the runtime library rather than here - see LowerShift, and
// shifthi3.S, which is a loop over exactly these. What keeps them in the
// backend is that the passes which shorten and relocate stack accesses have to
// know them: StackToIndexed rewrites each to its ,x form and DirectPageBank
// refuses to promote a slot that any of them touches, since the direct-page
// column has no read-modify-write at all.
//===----------------------------------------------------------------------===//

let isCodeGenOnly = 1, hasSideEffects = 0, mayLoad = 1, Defs = [NZV] in {
  def TSTsp : F24P<0x6D, AddrModeSp1, (outs), (ins spmem:$b0), "tst\t$b0", []>;
  let mayStore = 1 in
  def DECsp : F24P<0x6A, AddrModeSp1, (outs), (ins spmem:$b0), "dec\t$b0", []>;
}

let isCodeGenOnly = 1, hasSideEffects = 0, mayLoad = 1, mayStore = 1 in {
  let Defs = [NZV, C] in {
    def LSLsp : F24P<0x68, AddrModeSp1, (outs), (ins spmem:$b0), "lsl\t$b0", []>;
    def LSRsp : F24P<0x64, AddrModeSp1, (outs), (ins spmem:$b0), "lsr\t$b0", []>;
    def ASRsp : F24P<0x67, AddrModeSp1, (outs), (ins spmem:$b0), "asr\t$b0", []>;
  }
  // The rotates are the half that carries, so they read C as well as write it.
  let Defs = [NZV, C], Uses = [C] in {
    def ROLsp : F24P<0x69, AddrModeSp1, (outs), (ins spmem:$b0), "rol\t$b0", []>;
    def RORsp : F24P<0x66, AddrModeSp1, (outs), (ins spmem:$b0), "ror\t$b0", []>;
  }
}

// Negate the accumulator.
let Constraints = "$src = $dst", isCodeGenOnly = 1, Defs = [NZV, C],
    hasSideEffects = 0 in
def NEG8 : F8<0x40, AddrModeInh, (outs GR8:$dst), (ins GR8:$src), "nega",
              [(set GR8:$dst, (sub 0, GR8:$src))]>;

// Single-bit accumulator shifts (the row-4 read-modify-write forms).
let Constraints = "$src = $dst", isCodeGenOnly = 1, Defs = [NZV, C],
    hasSideEffects = 0 in {
  def SHL8 : F8<0x48, AddrModeInh, (outs GR8:$dst), (ins GR8:$src), "lsla",
                [(set GR8:$dst, (HCS08shl1 GR8:$src))]>;
  def SRL8 : F8<0x44, AddrModeInh, (outs GR8:$dst), (ins GR8:$src), "lsra",
                [(set GR8:$dst, (HCS08srl1 GR8:$src))]>;
  def SRA8 : F8<0x47, AddrModeInh, (outs GR8:$dst), (ins GR8:$src), "asra",
                [(set GR8:$dst, (HCS08sra1 GR8:$src))]>;
}

//===----------------------------------------------------------------------===//
// Compares and conditional branches (code generation).
//===----------------------------------------------------------------------===//

// cmp A against an immediate or a memory operand, setting the condition codes.
// Column 1 of the matrix, so the addressing modes follow the same rows as the
// 8-bit ALU.
let Defs = [NZV, C], isCodeGenOnly = 1, hasSideEffects = 0 in {
  def CMP8i : F16<0xA1, AddrModeImm, (outs), (ins GR8:$src, imm8:$b0),
                  "cmp\t#$b0", [(HCS08cmp GR8:$src, imm:$b0)]>;
  def CMP8dir : F16<0xB1, AddrModeDir, (outs), (ins GR8:$src, dpmem:$b0),
                    "cmp\t$b0", [(HCS08cmp GR8:$src, (load dpaddr:$b0))]>;
  def CMP8ext : F24<0xC1, AddrModeExt, (outs), (ins GR8:$src, imm16:$w0),
                    "cmp\t$w0", [(HCS08cmp GR8:$src, (load extaddr:$w0))]>;
  let mayLoad = 1 in {
    def CMP8sp : F24P<0xE1, AddrModeSp1, (outs), (ins GR8:$src, spmem:$b0),
                      "cmp\t$b0", [(HCS08cmp GR8:$src, (load stackaddr:$b0))]>;
    def CMP8ix2 : F24<0xD1, AddrModeIx2, (outs), (ins GR8:$src, ixmem16:$w0),
                      "cmp\t$w0", [(HCS08cmp GR8:$src, (load ixaddr16:$w0))]>;
    def CMP8ix1 : F16<0xE1, AddrModeIx1, (outs), (ins GR8:$src, ixmem:$b0),
                      "cmp\t$b0", [(HCS08cmp GR8:$src, (load ixaddr:$b0))]>;
    def CMP8ix : F8<0xF1, AddrModeIx, (outs), (ins GR8:$src, GR16:$base),
                    "cmp\t,x", [(HCS08cmp GR8:$src, (load ixbase:$base))]>;
  }
  // A second operand in a register, which this machine cannot compare against
  // any more than it can add to: parked in a frame byte by the custom
  // inserter, exactly as the reg-reg ALU is.
  let isPseudo = 1, usesCustomInserter = 1 in
  def CMP8rr : HCS08Inst<0, AddrModeNone, (outs), (ins GR8:$src, GR8:$src2),
                         "", [(HCS08cmp GR8:$src, GR8:$src2)]>;
}

// cphx compares the whole of H:X in one go, so a 16-bit comparison needs no
// byte chain - unlike a 16-bit addition. There is no indexed form, so a value
// reached through a pointer goes through the parked form below.
let Defs = [NZV, C], isCodeGenOnly = 1, hasSideEffects = 0 in {
  def CMP16i : F24<0x65, AddrModeImm, (outs), (ins GR16:$src, imm16:$w0),
                   "cphx\t#$w0", [(HCS08cmp GR16:$src, imm:$w0)]>;
  def CMP16dir : F16<0x75, AddrModeDir, (outs), (ins GR16:$src, dpmem:$b0),
                     "cphx\t$b0", [(HCS08cmp GR16:$src, (load dpaddr:$b0))]>;
  def CMP16ext : F24<0x3E, AddrModeExt, (outs), (ins GR16:$src, imm16:$w0),
                     "cphx\t$w0", [(HCS08cmp GR16:$src, (load extaddr:$w0))]>;
  let mayLoad = 1 in
  def CMP16sp : F24P<0xF3, AddrModeSp1, (outs), (ins GR16:$src, spmem:$b0),
                     "cphx\t$b0", [(HCS08cmp GR16:$src, (load stackaddr:$b0))]>;
  let isPseudo = 1, usesCustomInserter = 1 in
  def CMP16rr : HCS08Inst<0, AddrModeNone, (outs), (ins GR16:$src, GR16:$src2),
                          "", [(HCS08cmp GR16:$src, GR16:$src2)]>;
}

// Selecting between two values needs a branch: there is no conditional move,
// and with one register per class the two candidates cannot both be held
// anyway. The custom inserter turns these into a diamond.
class SelectCC<RegisterClass RC>
    : HCS08Inst<0, AddrModeNone, (outs RC:$dst),
                (ins RC:$t, RC:$f, imm8:$cc), "",
                [(set RC:$dst, (HCS08selectcc RC:$t, RC:$f, imm:$cc))]> {
  let isPseudo = 1;
  let isCodeGenOnly = 1;
  let usesCustomInserter = 1;
  let Uses = [NZV, C];
  let hasSideEffects = 0;
}

def SELECT8 : SelectCC<GR8>;
def SELECT16 : SelectCC<GR16>;

// One conditional branch per condition code. These are pattern-less: a
// HCS08ISD::BR_CC node is matched to the right one by C++ custom selection in
// HCS08ISelDAGToDAG (indexed by the HCS08CC condition value). PC-relative.
// Each reads only the flags its condition actually tests: the unsigned
// ordered branches are the carry, the signed ones are N against V, and the
// two that combine them need both.
let isBranch = 1, isTerminator = 1, isCodeGenOnly = 1 in
class BranchCC<bits<8> op, string m, list<Register> flags>
    : F16<op, AddrModeRel, (outs), (ins brtarget2:$b0), m # "\t$b0", []> {
  let Uses = flags;
}

def BEQcc : BranchCC<0x27, "beq", [NZV]>;
def BNEcc : BranchCC<0x26, "bne", [NZV]>;
def BHScc : BranchCC<0x24, "bcc", [C]>;
def BLOcc : BranchCC<0x25, "bcs", [C]>;
def BHIcc : BranchCC<0x22, "bhi", [NZV, C]>;
def BLScc : BranchCC<0x23, "bls", [NZV, C]>;
def BGEcc : BranchCC<0x90, "bge", [NZV]>;
def BLTcc : BranchCC<0x91, "blt", [NZV]>;
def BGTcc : BranchCC<0x92, "bgt", [NZV]>;
def BLEcc : BranchCC<0x93, "ble", [NZV]>;
def BMIcc : BranchCC<0x2B, "bmi", [NZV]>;
def BPLcc : BranchCC<0x2A, "bpl", [NZV]>;

// A flag-setting instruction and the branch that reads it, held together as
// one instruction until after register allocation.
//
// They have to be inseparable rather than merely adjacent. Every reload on
// this machine is an lda, which sets N and Z, and register allocation inserts
// reloads without consulting the liveness of a reserved register - LLVM
// assumes throughout that spill code does not clobber flags. A value live out
// of a loop latch is reloaded at the end of the block, which is exactly
// between the compare and the branch, and the branch then tests the reload.
//
// The operands are the branch opcode, the flag-setting opcode, the
// destination, and then whatever operands that flag-setting instruction had -
// variadic, so that one pseudo covers every addressing mode of every compare.
// mayLoad and mayStore because the folded instruction may be either: a compare
// against a frame slot reads memory, and the decrement a countdown loop ends
// with reads and writes it.
let isPseudo = 1, isCodeGenOnly = 1, isBranch = 1, isTerminator = 1,
    Defs = [NZV, C], hasSideEffects = 0, mayLoad = 1, mayStore = 1 in
def CMPBR : HCS08Inst<6, AddrModeNone, (outs),
                      (ins i16imm:$brop, i16imm:$cmpop, brtarget2:$dst,
                       variable_ops), "", []>;

// Unconditional branch, custom-selected from ISD::BR (see HCS08ISelDAGToDAG).
let isBranch = 1, isTerminator = 1, isBarrier = 1, isCodeGenOnly = 1 in {
def BRAcc : F16<0x20, AddrModeRel, (outs), (ins brtarget2:$b0), "bra\t$b0", []>;

// The same reach as the whole address space, for when the relative branch
// cannot get there. Branch relaxation rewrites into this.
def JMPa : F24<0xCC, AddrModeExt, (outs), (ins imm16:$w0), "jmp\t$w0", []>;
}

//===----------------------------------------------------------------------===//
// Stack-relative load/store and stack-pointer adjust (code generation).
//
// These are emitted by frame lowering / register spilling and selected for
// frame-index addresses. The $base operand carries a frame index at
// instruction-selection time and is rewritten to SP with a concrete
// displacement by eliminateFrameIndex.
//===----------------------------------------------------------------------===//

let isCodeGenOnly = 1, Uses = [SP], hasSideEffects = 0, Defs = [NZV] in {
  let mayLoad = 1 in {
    def LDAsp : F24P<0xE6, AddrModeSp1, (outs GR8:$dst), (ins spmem:$b0),
                     "lda\t$b0", []>;
    def LDHXsp : F24P<0xFE, AddrModeSp1, (outs GR16:$dst), (ins spmem:$b0),
                      "ldhx\t$b0", []>;
  }
  let mayStore = 1 in {
    def STAsp : F24P<0xE7, AddrModeSp1, (outs), (ins GR8:$src, spmem:$b0),
                     "sta\t$b0", []>;
    def STHXsp : F24P<0xFF, AddrModeSp1, (outs), (ins GR16:$src, spmem:$b0),
                      "sthx\t$b0", []>;
  }
}

// Anything living in a frame object - an incoming stack argument, an alloca,
// a spill slot - is reached through these.
def : Pat<(i8  (load stackaddr:$addr)), (LDAsp  stackaddr:$addr)>;
def : Pat<(i16 (load stackaddr:$addr)), (LDHXsp stackaddr:$addr)>;
def : Pat<(store GR8:$src,  stackaddr:$addr), (STAsp  GR8:$src,  stackaddr:$addr)>;
def : Pat<(store GR16:$src, stackaddr:$addr), (STHXsp GR16:$src, stackaddr:$addr)>;

// The address of a frame object, for taking a pointer to a local or for
// choosing between two of them - DAG combining turns a select of two loads
// into a load of a selected address, so this is not only about &local.
//
// tsx puts SP+1 in H:X and aix walks from there; the displacement is only
// known once frame indices are resolved, so the walk is emitted in
// expandPostRAPseudo. Neither instruction touches the condition codes.
let isCodeGenOnly = 1, hasSideEffects = 0 in {
  let Uses = [SP] in
  def TSXd : F8<0x95, AddrModeInh, (outs GR16:$dst), (ins), "tsx", []>;

  let isPseudo = 1, Uses = [SP] in
  def FRAMEADDR : HCS08Inst<5, AddrModeNone, (outs GR16:$dst), (ins spmem:$b0),
                            "", []>;
}

// Add a signed byte to SP (frame allocate/free).
let isCodeGenOnly = 1, Defs = [SP], Uses = [SP], hasSideEffects = 0 in
def AISi : F16<0xA7, AddrModeImm, (outs), (ins imm8:$b0), "ais\t#$b0", []>;

//===----------------------------------------------------------------------===//
// Index-register forms of the frame accesses.
//
// Every stack-relative form is on page 2, and the page-2 opcode byte is the
// same as the n,x one: "lda $03,sp" is 9E E6 03 where "lda $02,x" is E6 02. So
// a frame access through H:X is the same instruction a byte shorter, and
// HCS08StackToIndexed rewrites runs of them once tsx has put the frame base
// there. These are the forms it rewrites to, for the operations whose n,x form
// is not already defined above with a pattern. Nothing selects them.
//===----------------------------------------------------------------------===//

let isCodeGenOnly = 1, hasSideEffects = 0, mayLoad = 1 in {
  let Constraints = "$src = $dst", Defs = [NZV, C], Uses = [C] in {
    def ADC8ix1 : F16<0xE9, AddrModeIx1, (outs GR8:$dst),
                      (ins GR8:$src, ixmem:$b0), "adc\t$b0", []>;
    def SBC8ix1 : F16<0xE2, AddrModeIx1, (outs GR8:$dst),
                      (ins GR8:$src, ixmem:$b0), "sbc\t$b0", []>;
  }

  let Defs = [X, NZV] in
  def LDXix1 : F16<0xEE, AddrModeIx1, (outs), (ins ixmem:$b0), "ldx\t$b0", []>;

  let Defs = [NZV] in {
    def TSTix1 : F16<0x6D, AddrModeIx1, (outs), (ins ixmem:$b0), "tst\t$b0", []>;
    let mayStore = 1 in
    def DECix1 : F16<0x6A, AddrModeIx1, (outs), (ins ixmem:$b0), "dec\t$b0", []>;
  }

  let mayStore = 1 in {
    let Defs = [NZV, C] in {
      def LSLix1 : F16<0x68, AddrModeIx1, (outs), (ins ixmem:$b0), "lsl\t$b0", []>;
      def LSRix1 : F16<0x64, AddrModeIx1, (outs), (ins ixmem:$b0), "lsr\t$b0", []>;
      def ASRix1 : F16<0x67, AddrModeIx1, (outs), (ins ixmem:$b0), "asr\t$b0", []>;
    }
    let Defs = [NZV, C], Uses = [C] in {
      def ROLix1 : F16<0x69, AddrModeIx1, (outs), (ins ixmem:$b0), "rol\t$b0", []>;
      def RORix1 : F16<0x66, AddrModeIx1, (outs), (ins ixmem:$b0), "ror\t$b0", []>;
    }
  }
}

//===----------------------------------------------------------------------===//
// Calls (code generation).
//===----------------------------------------------------------------------===//

// Stores into the outgoing-argument area of the reserved call frame. Unlike
// STAsp / STHXsp the displacement is already an SP offset, so these never
// reach eliminateFrameIndex.
let isCodeGenOnly = 1, Uses = [SP], mayStore = 1, hasSideEffects = 0,
    Defs = [NZV] in {
  def STAout : F24P<0xE7, AddrModeSp1, (outs), (ins GR8:$src, imm8:$b0),
                    "sta\t$b0,sp", [(store GR8:$src, (HCS08outarg timm:$b0))]>;
  def STHXout : F24P<0xFF, AddrModeSp1, (outs), (ins GR16:$src, imm8:$b0),
                     "sthx\t$b0,sp",
                     [(store GR16:$src, (HCS08outarg timm:$b0))]>;
}

// Call-sequence markers, expanded away by eliminateCallFramePseudoInstr.
let Defs = [SP], Uses = [SP] in {
  def ADJCALLSTACKDOWN
      : HCS08Pseudo<(outs), (ins i16imm:$amt1, i16imm:$amt2),
                    [(HCS08callseq_start timm:$amt1, timm:$amt2)]>;
  def ADJCALLSTACKUP
      : HCS08Pseudo<(outs), (ins i16imm:$amt1, i16imm:$amt2),
                    [(HCS08callseq_end timm:$amt1, timm:$amt2)]>;
}

// Direct call to a 16-bit absolute address. Clobbers the caller-saved
// registers; the return value comes back in A / H:X.
let isCall = 1, isCodeGenOnly = 1, Defs = [A, HX, NZV, C] in
def JSRe : F24<0xCD, AddrModeExt, (outs), (ins imm16:$w0), "jsr\t$w0", []>;

def : Pat<(HCS08call (i16 tglobaladdr:$dst)), (JSRe tglobaladdr:$dst)>;
def : Pat<(HCS08call (i16 texternalsym:$dst)), (JSRe texternalsym:$dst)>;

// Calling a value rather than a symbol. There is a jsr ,x, but it wants the
// target in H:X and H:X is where the first 16-bit argument goes, so the two
// collide on the one pointer register this machine has - and the argument
// cannot go anywhere else, because the callee is what decides where to read
// it. Nothing can be left in a register at the point of the jump.
//
// So the jump is an rts, which reads its destination from the stack and needs
// no register at all. LowerCall lays out four bytes at the bottom of the
// outgoing arguments, target first and return address above it, so that
//
//   rts   pops the target into PC and leaves the return address on top,
//         exactly as a jsr would have
//
// and the stack arguments, shifted up by those four bytes, land where the
// callee expects them. The stores happen before the argument registers are
// loaded, which is what makes the collision go away, and SP never moves, which
// is what keeps every other offset in the call sequence correct.
//
// The operand is the label the callee returns to; the asm printer emits it
// immediately after the rts. Both this and the RetAddr node that materialises
// the same label are selected by hand in HCS08ISelDAGToDAG, because the
// operand is an MCSymbol and there is no target-constant form of one to write
// a pattern against.
let isCall = 1, isCodeGenOnly = 1, isPseudo = 1, Defs = [A, HX, NZV, C] in
def CALLind : HCS08Inst<1, AddrModeInh, (outs), (ins i16imm:$ret), "", []>;
