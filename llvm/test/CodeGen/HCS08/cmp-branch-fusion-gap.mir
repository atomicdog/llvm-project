# RUN: llc -mtriple=hcs08 -run-pass=hcs08-fuse-compare-branch -verify-machineinstrs %s -o - | FileCheck %s

# A compare is not guaranteed to still be next to its branch by the time this
# pass runs. Anything that believes it leaves the flags alone may be placed
# between the two, and fusing only an immediately adjacent pair silently gives
# up when one is. Giving up is not neutral: the pair stays split, and register
# allocation then puts a reload in the same gap. Every reload here is an lda,
# and lda sets N and Z, so the branch ends up testing the reload.
#
# That is the -Os printf miscompile: the value reloaded into the gap was a
# conversion base, always 8, 10 or 16, so a `longs == 0` test never took its
# zero side and every %u ran the 32-bit converter over a 16-bit argument.

--- |
  define i16 @close_the_gap(i8 %longs) { ret i16 0 }
  define i16 @extend_writes_flags(i8 %longs) { ret i16 0 }
  define i16 @flags_written_in_between(i8 %longs) { ret i16 0 }
  define i16 @compare_operand_clobbered() { ret i16 0 }
...

---
# aix is one of the few instructions here that genuinely leaves the CCR alone,
# so the compare can move down to meet its branch and the two fold together.
name:            close_the_gap
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a, $hx

    %0:gr8 = COPY $a
    %1:gr16 = COPY $hx
    CMP8i %0, 0, implicit-def $nzv, implicit-def dead $c
    %2:gr16 = AIXi %1, 7
    BNEcc %bb.2, implicit $nzv
    BRAcc %bb.1

  bb.1:
    $hx = COPY %2
    RTS implicit $hx

  bb.2:
    $hx = COPY %2
    RTS implicit $hx

# CHECK-LABEL: name: close_the_gap
# The aix is left above the compare, and what follows it is one instruction.
# CHECK:      %2:gr16 = AIXi %1, 7
# CHECK-NEXT: CMPBR {{[0-9]+}}, {{[0-9]+}}, %bb.2, %0, 0, implicit-def $nzv
# CHECK-NOT:  CMP8i
# CHECK-NOT:  BNEcc
...

---
# ZEXT8to16 is `tax; clrh`, and clrh writes the flags like the rest of the clr
# family - V and N cleared, Z set. So an extend in the gap is itself what the
# branch reads, and nothing may be fused across it. Before that was modelled,
# MachineCSE hoisted exactly this instruction into exactly this position.
name:            extend_writes_flags
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a

    %0:gr8 = COPY $a
    %1:gr8 = LDAi 10, implicit-def dead $nzv
    CMP8i %0, 0, implicit-def $nzv, implicit-def dead $c
    %2:gr16 = ZEXT8to16 %1, implicit-def $nzv
    BNEcc %bb.2, implicit $nzv
    BRAcc %bb.1

  bb.1:
    $hx = COPY %2
    RTS implicit $hx

  bb.2:
    $hx = COPY %2
    RTS implicit $hx

# CHECK-LABEL: name: extend_writes_flags
# CHECK:      CMP8i
# CHECK:      ZEXT8to16
# CHECK-NEXT: BNEcc
# CHECK-NOT:  CMPBR
...

---
# The same thing with an explicit arithmetic flag write, which is the shape a
# reload would have had if one reached this pass.
name:            flags_written_in_between
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a

    %0:gr8 = COPY $a
    %1:gr8 = LDAi 10, implicit-def dead $nzv
    CMP8i %0, 0, implicit-def $nzv, implicit-def dead $c
    %2:gr8 = AND8i %1, 32, implicit-def $nzv
    BNEcc %bb.2, implicit $nzv
    BRAcc %bb.1

  bb.1:
    RTS

  bb.2:
    RTS

# CHECK-LABEL: name: flags_written_in_between
# CHECK:      CMP8i
# CHECK:      AND8i
# CHECK-NEXT: BNEcc
# CHECK-NOT:  CMPBR
...

---
# The gap instruction redefines the register the compare reads. Sinking the
# compare past it would compare the new value, so this one stays split too.
name:            compare_operand_clobbered
tracksRegLiveness: true
isSSA:           false
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a

    CMP8i $a, 0, implicit-def $nzv, implicit-def dead $c
    $a = LDAi 10, implicit-def dead $nzv
    BNEcc %bb.2, implicit $nzv
    BRAcc %bb.1

  bb.1:
    RTS

  bb.2:
    RTS

# CHECK-LABEL: name: compare_operand_clobbered
# CHECK-NOT:  CMPBR
...
